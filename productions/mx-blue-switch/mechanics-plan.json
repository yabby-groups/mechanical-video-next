  "presentation": {
    "ff9ed64797cf3576e895923567fa6e421cc316fe7cc3a46cbdbc38bbedd73bdf": {
      "0": "输出帧 18、22、25，按压中白色滑块相对蓝轴心加速下落，两侧脚落在蓝色座面。",
      "1": "输出帧 250、440，蓝色轴心和它下面的白件可独立辨认，白件接触两侧蓝色座面后分离。",
      "2": "输出帧 550、680，上盖和轴心抬离底座，弹簧在中央，金色弹片留在侧边并接向底座。",
      "3": "输出帧 783、786、790，白色腿下端从远离蓝色座面过渡到贴合，蓝轴心仍继续下移。",
      "4": "输出帧 1060、1100、1160、1295，两个金色凸点由分开到邻接、继而再次分开。",
      "5": "输出帧 1425、1450、1550，压缩弹簧伸长，带起轴心和白件，金色触点重新分开。",
      "6": "输出帧 1630、1700、1780，两轴心同向下压，右侧红件为一体，左侧白滑块相对蓝轴心下落。",
      "7": "输出帧 1997、2106、2160，先见键帽上方，随后白件落座，键帽在触发状态后继续下移。字幕 2.2 mm 对应原厂标称值。"
    }
  }
}

    "narration": [
      {
        "id": "snap-1",
        "start_frame": 3,
        "deadline_frame": 77,
        "text": "看白色滑块，它突然跳了一下。",
        "knowledge_ids": [
          "snap"
        ]
      },
      {
        "id": "snap-2",
        "start_frame": 80,
        "deadline_frame": 208,
        "text": "手还在匀速往下按，白色滑块却抢先撞了下去。",
        "knowledge_ids": [
          "snap"
        ]
      },
      {
        "id": "two-parts-1",
        "start_frame": 213,
        "deadline_frame": 381,
        "text": "拆开一颗青轴，键帽底下，蓝色轴心和白色滑块是分开的。",
        "knowledge_ids": [
          "two-parts"
        ]
      },
      {
        "id": "two-parts-2",
        "start_frame": 384,
        "deadline_frame": 480,
        "text": "所以同一次按压，里面有两种速度。",
        "knowledge_ids": [
          "two-parts"
        ]
      },
      {
        "id": "teardown-1",
        "start_frame": 489,
        "deadline_frame": 583,
        "text": "拿掉上盖，能看见中间的回位弹簧。",
        "knowledge_ids": [
          "teardown"
        ]
      },
      {
        "id": "teardown-2",
        "start_frame": 586,
        "deadline_frame": 706,
        "text": "金色触点贴在一侧，最后接到下面这两根脚。",
        "knowledge_ids": [
          "teardown"
        ]
      },
      {
        "id": "impact-1",
        "start_frame": 720,
        "deadline_frame": 855,
        "text": "再慢按一次。白色滑块先跟着蓝色轴心走。",
        "knowledge_ids": [
          "impact"
        ]
      },
      {
        "id": "impact-2",
        "start_frame": 858,
        "deadline_frame": 1019,
        "text": "越过触感点，白件突然滑落，撞到了轴心。那一下就是响声。",
        "knowledge_ids": [
          "impact"
        ]
      },
      {
        "id": "switching-1",
        "start_frame": 1026,
        "deadline_frame": 1168,
        "text": "换到触点这一侧。原来分开的两片金属，现在碰到一起了。",
        "knowledge_ids": [
          "switching"
        ]
      },
      {
        "id": "switching-2",
        "start_frame": 1171,
        "deadline_frame": 1306,
        "text": "键盘读的是这里的通断，耳朵听到的是旁边的撞击。",
        "knowledge_ids": [
          "switching"
        ]
      },
      {
        "id": "reset-1",
        "start_frame": 1320,
        "deadline_frame": 1431,
        "text": "松手时，压短的弹簧把轴心往上推。",
        "knowledge_ids": [
          "reset"
        ]
      },
      {
        "id": "reset-2",
        "start_frame": 1434,
        "deadline_frame": 1578,
        "text": "触点重新分开，白色滑块也回到能再响一次的位置。",
        "knowledge_ids": [
          "reset"
        ]
      },
      {
        "id": "comparison-1",
        "start_frame": 1593,
        "deadline_frame": 1720,
        "text": "左边青轴，右边红轴，用一样的速度压下去。",
        "knowledge_ids": [
          "comparison"
        ]
      },
      {
        "id": "comparison-2",
        "start_frame": 1723,
        "deadline_frame": 1884,
        "text": "红轴也能接通触点，少了单独跳落的白色件，手感是线性的。",
        "knowledge_ids": [
          "comparison"
        ]
      },
      {
        "id": "travel-1",
        "start_frame": 1905,
        "deadline_frame": 2028,
        "text": "所以用青轴打一行字，听见的咔哒来自白件跳落。",
        "knowledge_ids": [
          "travel"
        ]
      },
      {
        "id": "travel-2",
        "start_frame": 2031,
        "deadline_frame": 2192,
        "text": "青轴标称触发行程二点二毫米，键帽还能继续向下走。",
        "knowledge_ids": [
          "travel"
        ]
      }
    ]
  },

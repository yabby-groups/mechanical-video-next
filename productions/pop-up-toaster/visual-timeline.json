    "narration": [
      {
        "id": "line-1-1",
        "start_frame": 42,
        "deadline_frame": 144,
        "text": "吐司一冒头，先动的是底下的托架。",
        "knowledge_ids": [
          "detail-1"
        ]
      },
      {
        "id": "line-1-2",
        "start_frame": 149,
        "deadline_frame": 237,
        "text": "两条槽底的横托，连到前面同一个滑架。",
        "knowledge_ids": [
          "detail-1"
        ]
      },
      {
        "id": "line-1-3",
        "start_frame": 242,
        "deadline_frame": 362,
        "text": "你家烤完，是正好露个头，还是一下蹿很高？",
        "knowledge_ids": [
          "detail-1"
        ]
      },
      {
        "id": "line-2-1",
        "start_frame": 366,
        "deadline_frame": 442,
        "text": "把黑色外壳和前面板移开。",
        "knowledge_ids": [
          "detail-2"
        ]
      },
      {
        "id": "line-2-2",
        "start_frame": 447,
        "deadline_frame": 504,
        "text": "两片吐司，各有一个槽。",
        "knowledge_ids": [
          "detail-2"
        ]
      },
      {
        "id": "line-2-3",
        "start_frame": 508,
        "deadline_frame": 609,
        "text": "所以你只按一根手柄，两片就一起往下走。",
        "knowledge_ids": [
          "detail-2"
        ]
      },
      {
        "id": "line-3-1",
        "start_frame": 614,
        "deadline_frame": 719,
        "text": "从正面看，浅色滑架沿着导向件往下走。",
        "knowledge_ids": [
          "detail-3"
        ]
      },
      {
        "id": "line-3-2",
        "start_frame": 726,
        "deadline_frame": 803,
        "text": "这时，上面的弹簧被拉长了。",
        "knowledge_ids": [
          "detail-3"
        ]
      },
      {
        "id": "line-3-3",
        "start_frame": 809,
        "deadline_frame": 916,
        "text": "你往下压时做的功，有一部分存进了弹簧。",
        "knowledge_ids": [
          "detail-3"
        ]
      },
      {
        "id": "line-3-4",
        "start_frame": 923,
        "deadline_frame": 1081,
        "text": "手松开，托架暂时仍停在底下，吐司就在加热区。",
        "knowledge_ids": [
          "detail-3"
        ]
      },
      {
        "id": "line-4-1",
        "start_frame": 1100,
        "deadline_frame": 1155,
        "text": "现在把释放这一瞬间放慢。",
        "knowledge_ids": [
          "detail-4"
        ]
      },
      {
        "id": "line-4-2",
        "start_frame": 1162,
        "deadline_frame": 1279,
        "text": "滑架一得到释放，上方拉长的弹簧就缩回去，",
        "knowledge_ids": [
          "detail-4"
        ]
      },
      {
        "id": "line-4-3",
        "start_frame": 1286,
        "deadline_frame": 1403,
        "text": "它拉着滑架往上走，两条横托一起抬起吐司。",
        "knowledge_ids": [
          "detail-4"
        ]
      },
      {
        "id": "line-4-4",
        "start_frame": 1410,
        "deadline_frame": 1539,
        "text": "升到顶端以后，托架停下来，吐司露出一截。",
        "knowledge_ids": [
          "detail-4"
        ]
      },
      {
        "id": "line-5-1",
        "start_frame": 1558,
        "deadline_frame": 1637,
        "text": "把这几件事放在一条时间线上看。",
        "knowledge_ids": [
          "detail-5"
        ]
      },
      {
        "id": "line-5-2",
        "start_frame": 1644,
        "deadline_frame": 1735,
        "text": "按下，托架先下降，弹簧先储能。",
        "knowledge_ids": [
          "detail-5"
        ]
      },
      {
        "id": "line-5-3",
        "start_frame": 1741,
        "deadline_frame": 1830,
        "text": "烘烤期间，托架一直被保持在下面。",
        "knowledge_ids": [
          "detail-5"
        ]
      },
      {
        "id": "line-5-4",
        "start_frame": 1836,
        "deadline_frame": 1960,
        "text": "到释放这一步，托架只用很短时间就能回到上面。",
        "knowledge_ids": [
          "detail-5"
        ]
      },
      {
        "id": "line-6-1",
        "start_frame": 1964,
        "deadline_frame": 2046,
        "text": "这张图只表示变化趋势。",
        "knowledge_ids": [
          "detail-6"
        ]
      },
      {
        "id": "line-7-1",
        "start_frame": 2063,
        "deadline_frame": 2144,
        "text": "再看同一台机器的两种结束方式。",
        "knowledge_ids": [
          "detail-7"
        ]
      },
      {
        "id": "line-7-2",
        "start_frame": 2151,
        "deadline_frame": 2249,
        "text": "正常烘烤，等这一轮结束，托架回升。",
        "knowledge_ids": [
          "detail-7"
        ]
      },
      {
        "id": "line-7-3",
        "start_frame": 2256,
        "deadline_frame": 2335,
        "text": "你也可以按取消，提前结束这一轮。",
        "knowledge_ids": [
          "detail-7"
        ]
      },
      {
        "id": "line-7-4",
        "start_frame": 2341,
        "deadline_frame": 2521,
        "text": "两个时候弹起的结果一样，你往下按的时候，就已经为回程储好了能量。",
        "knowledge_ids": [
          "detail-7"
        ],
        "subtitles": [
          {
            "offset_samples": 0,
            "text": "两个时候弹起的结果一样，"
          },
          {
            "offset_samples": 144048,
            "text": "你往下按的时候，就已经为回程储好了能量。"
          }
        ]
      },
      {
        "id": "line-8-1",
        "start_frame": 2540,
        "deadline_frame": 2629,
        "text": "机身底下还有一块容易漏看的活动板。",
        "knowledge_ids": [
          "detail-8"
        ]
      },
      {
        "id": "line-8-2",
        "start_frame": 2635,
        "deadline_frame": 2755,
        "text": "碎屑落在它上面，原厂给了下翻式接渣盘。",
        "knowledge_ids": [
          "detail-8"
        ]
      },
      {
        "id": "line-8-3",
        "start_frame": 2762,
        "deadline_frame": 2886,
        "text": "拔掉电源，等机器冷下来，再打开接渣盘清理。",
        "knowledge_ids": [
          "detail-8"
        ]
      },
      {
        "id": "line-8-4",
        "start_frame": 2893,
        "deadline_frame": 2938,
        "text": "清完记得把它扣回去。",
        "knowledge_ids": [
          "detail-8"
        ]
      },
      {
        "id": "line-9-1",
        "start_frame": 2957,
        "deadline_frame": 3012,
        "text": "再追一次这条路线。",
        "knowledge_ids": [
          "detail-9"
        ]
      },
      {
        "id": "line-9-2",
        "start_frame": 3019,
        "deadline_frame": 3132,
        "text": "手柄压下滑架，弹簧存住回程的能量。",
        "knowledge_ids": [
          "detail-9"
        ]
      },
      {
        "id": "line-9-3",
        "start_frame": 3138,
        "deadline_frame": 3243,
        "text": "保持结束，弹簧把两片一起抬起来。",
        "knowledge_ids": [
          "detail-9"
        ]
      },
      {
        "id": "line-9-4",
        "start_frame": 3250,
        "deadline_frame": 3408,
        "text": "下次看到吐司跳出来，想想起跳的动作，其实从按下去就开始了。",
        "knowledge_ids": [
          "detail-9"
        ],
        "subtitles": [
          {
            "offset_samples": 0,
            "text": "下次看到吐司跳出来，"
          },
          {
            "offset_samples": 123504,
            "text": "想想起跳的动作，其实从按下去就开始了。"
          }
        ]
      }
    ],

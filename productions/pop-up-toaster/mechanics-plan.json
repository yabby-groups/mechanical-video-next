  "presentation": {
    "85715b6f385e40148db62380ffb4e2693315c55e3a1a743c704e21353e3fcc16": {
      "0": "抽查 0.00–6.00 秒，剖开角度可见横托支撑两片同步上升，切回外壳后回放同一回升。3.67 秒显示横托、支臂与共用滑架连接。",
      "1": "抽查 11.67–20.23 秒，先移开外壳和前板，再露出双槽及共用滑架。手柄、两条横托和吐司一起下降。",
      "2": "抽查 22.00–36.43 秒，滑架沿导向下移，上弹簧拉长，托架停在低位。屏上标注与三个状态对应。",
      "3": "抽查 36.53–51.30 秒，上弹簧从拉长状态收回，横托把两片一起抬上去并停在顶部。",
      "4": "抽查 53.10–64.17 秒，蓝线与橙线同步画出方向相反的变化、共同保持和回升。画面标示趋势示意。",
      "5": "抽查 65.93 和 68.57 秒，切回顶部静止状态，图解收束后用标签颜色在三维画面中指认对应部件。",
      "6": "抽查 68.60–84.00 秒，正常结束时吐司先从槽内正常弹出。切换到第二次低位，76.50–76.80 秒指尖朝向并按入旋钮中心，77.13 秒吐司回升。",
      "7": "抽查 84.50–98.33 秒，先见接渣盘闭合，89.00 秒下翻，90.67–95.67 秒见打开的底框、槽下通路和盘面碎屑，97.00–98.33 秒沿同一轴合回。",
      "8": "抽查 98.43–113.90 秒，完整总结镜从托架高位，经下压和低位保持，再回到顶部。弹簧伸长和缩短与滑架动作同步。"
    }
  }

  "presentation": {
    "85715b6f385e40148db62380ffb4e2693315c55e3a1a743c704e21353e3fcc16": {
      "0": "抽查 0.00–6.00 秒，剖开角度可见横托支撑两片同步上升，切回外壳后回放同一回升。3.67 秒显示横托、支臂与共用滑架连接。",
      "1": "抽查 11.67–20.23 秒，先移开外壳和前板，再露出双槽及共用滑架。手柄、两条横托和吐司一起下降。",
      "2": "抽查 22.00–36.43 秒，滑架沿导向下移，上弹簧拉长，托架停在低位。屏上标注与三个状态对应。",
      "3": "抽查 36.53–51.30 秒，上弹簧从拉长状态收回，横托把两片一起抬上去并停在顶部。",
      "4": "抽查 53.10–64.17 秒，蓝线与橙线同步画出方向相反的变化、共同保持和回升。画面标示趋势示意。",
      "5": "抽查 65.93 和 68.57 秒，切回顶部静止状态，图解收束后用标签颜色在三维画面中指认对应部件。",
      "6": "抽查 68.60–84.00 秒，正常结束时吐司先从槽内正常弹出。切换到第二次低位，76.50–76.80 秒指尖朝向并按入旋钮中心，77.13 秒吐司回升。",
      "7": "抽查 84.50–98.33 秒，先见接渣盘闭合，89.00 秒下翻，90.67–95.67 秒见打开的底框、槽下通路和盘面碎屑，97.00–98.33 秒沿同一轴合回。",
      "8": "抽查 98.43–113.90 秒，完整总结镜从托架高位，经下压和低位保持，再回到顶部。弹簧伸长和缩短与滑架动作同步。"
    },
    "2a211dd3472220cc3c392254df67286b6079304827adda9facb4002a1cdbebb9": {
      "0": "0.033、0.700、1.333 秒，开壳视角中两片吐司随各自横托一起升起，能看到共用滑架和弹簧。",
      "1": "1.433、3.233、5.000 秒，近景保留两片吐司底下的横托及前端连接，其中前方弹簧靠近同一滑架。",
      "2": "5.100、6.100、7.067 秒，从两条横托过渡到完整外壳，吐司位置保持在高位。",
      "3": "7.167、9.267、11.367 秒，整机保持高位，能看到两条并列槽口和两片露头的吐司。",
      "4": "11.467、13.100、14.700 秒，黑色外壳与顶板分离，前端手柄、滑架和两槽位置随之露出。",
      "5": "14.800、17.533、20.233 秒，拆去槽侧遮挡后可追踪两条横托接至同一前端滑架。",
      "6": "20.333、22.333、24.300 秒，正面可见滑架两侧导向，滑架下降，上方回位弹簧同时拉长。",
      "7": "24.400、26.667、28.900 秒，顺接上镜下降行程，弹簧线圈间距增大，浅色滑架处在下端连接点。",
      "8": "29.000、32.733、36.433 秒，滑架保持低位，弹簧保持拉长，未在保持阶段回缩。",
      "9": "36.533、44.133、51.700 秒，托架从低位进入释放回升，再停在高位，两片吐司随横托一起受托。",
      "10": "51.800、58.767、65.733 秒，定性曲线显示托架下降时弹簧拉长，低位保持，回升时弹簧缩回，画面标注趋势示意。",
      "11": "65.700 秒的趋势曲线和 65.900 秒的三维高位画面显示同一句字幕。67.200、68.533 秒可顺着配色找到托架和上方弹簧。",
      "12": "68.633、71.933、75.200 秒，恢复外壳后可辨低位吐司及两条槽口，前端旋钮与下压的手柄在同一机身。",
      "13": "75.900、76.650、76.800、77.130、77.970 秒，指尖靠近旋钮中心、按压区域被指尖遮挡，手柄与吐司随后升起，指尖撤开后取消键重新可见。",
      "14": "78.067、79.333、80.567 秒，回到较宽构图，两片吐司与手柄保持在升起位置。",
      "15": "80.667、82.567、84.433 秒，整机保持高位，前端控制与上方两片吐司仍同框。",
      "16": "84.533、91.433、98.333 秒，从机底观察接渣盘由闭合翻开再复位，打开时可见内部开口及盘上碎屑。",
      "17": "98.433、106.233、114.000 秒，回到剖视重复展示低位释放后托架与吐司同向升起，上方弹簧缩回。"
    }
  }
}

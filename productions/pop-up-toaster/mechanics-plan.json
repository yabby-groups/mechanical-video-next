  "claims": {
    "lift": {
      "quote": "按下时两槽的托架随共同的滑架下行",
      "source": "https://www.ifixit.com/Guide/Black+and+Decker+TR1278B+Lever+Catch-Spring+Replacement/86997 (步骤 7–9)；https://www.ifixit.com/Guide/Black+and+Decker+TR1278B+Bread+Grabber+Spring+Replacement/86994",
      "expectation": "手柄和两槽横托经支臂与共用滑架同程，沿机身固定导向下压。两横托保持在吐司底面。解除低位保持后，同一支撑抬升两片至顶端。滑架上下端点是教学模型的行程。"
    },
    "spring": {
      "quote": "滑架上方的弹簧伸长。低位保持结束后，回程由弹簧驱动。",
      "source": "https://www.ifixit.com/Guide/Black+and+Decker+TR1278B+Lever+Catch-Spring+Replacement/86997 (步骤 7–9)",
      "expectation": "上端留在固定座，下端接滑架。下压时弹簧变长，低位保持时保持伸长，解除保持后收缩并带动滑架回升。几何检查对应模型锚点与相对长度，内部保持和释放机构留在表达范围以外。"
    },
    "cancel": {
      "quote": "原厂正面照片可见 CANCEL 位于旋钮中心。",
      "source": "https://www.blackanddecker.com/products/tr1278b",
      "expectation": "指尖先接触并按入旋钮中心的 CANCEL，低位滑架随后回升。正常结束也从低位回到顶部。按键行程为教学示意，内部信号与触发机制留在表达范围以外。"
    },
    "tray": {
      "quote": "下翻式接渣盘的参照。",
      "source": "https://www.ifixit.com/Guide/Black+and+Decker+TR1278B+Lever+Catch-Spring+Replacement/86997#s162661",
      "expectation": "维修步骤 2 显示接渣盘位于固定底框内并要求清空。闭合时两槽下方的通路通向盘面，固定底框不横跨通路。盘绕固定端朝下转出，随后沿原轴合回。铰接座、角度和开口尺寸为教学简化。"
    },
    "cycle_chart": {
      "quote": "根据相对固定上端的滑架位置绘制下压、低位保持、释放回升三个阶段。",
      "source": "本集研究的滑架与弹簧关系，依据 https://www.ifixit.com/Guide/Black+and+Decker+TR1278B+Lever+Catch-Spring+Replacement/86997 (步骤 7–9)",
      "expectation": "定性图共用时间轴，下降和伸长同步，低位保持时两者水平，回升和缩短同步。图形标示趋势。"
    }
  },

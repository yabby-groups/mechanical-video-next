  "presentation": {
    "34b32c6ac2a0838158058478d2e4b18b6a9ad84605a861a63e3334752a573a0c": {
      "0": "0.033、1.100、2.167 秒，滚轮橙色标记绕轴移动，活动钳口指针相对固定刻线横移。",
      "1": "2.267、3.533、4.767 秒，局部构图可辨螺旋、齿条及固定刻线，钳口保留前镜末端的位置。",
      "2": "4.867、8.533、12.167 秒，恢复较宽构图，齿条和滚轮仍在窗口中，能辨认其与固定钳口及手柄的关系。",
      "3": "12.267、19.067、25.867 秒，组件由装配态打开，轴沿滚轮轴线抽出、齿条随活动钳口离开，最后复装。",
      "4": "25.967、27.667、29.367 秒，啮合关系中的橙色示意点位于螺旋和齿条附近，齿距刻线在同一构图内。",
      "5": "29.467、30.700、31.900 秒，局部清楚显示橙色示意点对应的齿面及螺旋边缘。",
      "6": "32.000、34.000、36.000 秒，较宽构图显示示意点朝相邻齿移动，固定刻线与活动指针同时可见。",
      "7": "36.100、38.367、40.633 秒，局部示意点改变方向回移，可同时辨认相邻齿。",
      "8": "40.733、43.367、45.967 秒，六角螺母进入两钳口之间，活动钳口收拢。",
      "9": "46.067、48.333、50.567 秒，两钳口贴在相对平面上，视角转动时螺母仍在两钳口之间。",
      "10": "50.667、52.200、53.700 秒，局部能辨认两侧钳口与螺母外平面的相对位置。",
      "11": "53.800、59.400、64.967 秒，松开状态留有间隙，扳手相对螺母偏转后接近六角角部。",
      "12": "65.067、68.100、71.100 秒，从手柄全长看转动，箭头在钳口附近标示接触力方向。",
      "13": "71.200、73.733、76.233 秒，回到滚轮窗口和六角螺母，同框保留钳口和轮齿。",
      "14": "76.333、79.167、82.000 秒，放大窗口和钳口，原螺母离开、钳口打开再换入较大的螺母。",
      "15": "82.100、87.767、93.400 秒，可辨滚轮螺旋和活动齿条，随后拉开构图可辨手柄与钳口。"
    }
  }

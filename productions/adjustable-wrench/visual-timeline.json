    "narration": [
      {
        "id": "line-1-1",
        "start_frame": 12,
        "deadline_frame": 93,
        "text": "拇指只在原地拨，钳口却横着走。",
        "knowledge_ids": [
          "detail-1"
        ]
      },
      {
        "id": "line-1-2",
        "start_frame": 100,
        "deadline_frame": 260,
        "text": "让活动扳手做到这一步的，是窗口里这颗带螺旋的滚轮。",
        "knowledge_ids": [
          "detail-1"
        ]
      },
      {
        "id": "line-1-3",
        "start_frame": 267,
        "deadline_frame": 365,
        "text": "滚轮每转一圈，活动钳口就挪过一格。",
        "knowledge_ids": [
          "detail-1"
        ]
      },
      {
        "id": "line-2-1",
        "start_frame": 372,
        "deadline_frame": 436,
        "text": "把滚轮和钳口分开看。",
        "knowledge_ids": [
          "detail-2"
        ]
      },
      {
        "id": "line-2-2",
        "start_frame": 443,
        "deadline_frame": 560,
        "text": "活动钳口的底下有一排齿，正好伸到滚轮上方。",
        "knowledge_ids": [
          "detail-2"
        ]
      },
      {
        "id": "line-2-3",
        "start_frame": 567,
        "deadline_frame": 768,
        "text": "中间这根轴把滚轮留在窗口里，扳手头里的导槽让钳口沿一个方向滑动。",
        "knowledge_ids": [
          "detail-2"
        ],
        "subtitles": [
          {
            "offset_samples": 0,
            "text": "中间这根轴把滚轮留在窗口里，"
          },
          {
            "offset_samples": 142992,
            "text": "扳手头里的导槽让钳口沿一个方向滑动。"
          }
        ]
      },
      {
        "id": "line-3-1",
        "start_frame": 783,
        "deadline_frame": 838,
        "text": "跟住螺旋顶端这一段。",
        "knowledge_ids": [
          "detail-3"
        ]
      },
      {
        "id": "line-3-2",
        "start_frame": 845,
        "deadline_frame": 969,
        "text": "滚轮转过半圈，和齿条相遇的位置就沿轴走了半格。",
        "knowledge_ids": [
          "detail-3"
        ]
      },
      {
        "id": "line-3-3",
        "start_frame": 976,
        "deadline_frame": 1119,
        "text": "转完一圈，接触换到隔壁一格，钳口再走完剩下的半格。",
        "knowledge_ids": [
          "detail-3"
        ]
      },
      {
        "id": "line-3-4",
        "start_frame": 1126,
        "deadline_frame": 1212,
        "text": "把滚轮反过来拨，钳口也就往回走。",
        "knowledge_ids": [
          "detail-3"
        ]
      },
      {
        "id": "line-4-1",
        "start_frame": 1226,
        "deadline_frame": 1305,
        "text": "张开后套上螺母，再把开口收紧。",
        "knowledge_ids": [
          "detail-4"
        ]
      },
      {
        "id": "line-4-2",
        "start_frame": 1312,
        "deadline_frame": 1432,
        "text": "两个钳口应该贴住六角上相对的两片平面。",
        "knowledge_ids": [
          "detail-4"
        ]
      },
      {
        "id": "line-4-3",
        "start_frame": 1438,
        "deadline_frame": 1603,
        "text": "换个角度看，扳手贴得越正，螺母在开口里乱晃的余地就越小。",
        "knowledge_ids": [
          "detail-4"
        ],
        "subtitles": [
          {
            "offset_samples": 0,
            "text": "换个角度看，扳手贴得越正，"
          },
          {
            "offset_samples": 89904,
            "text": "螺母在开口里乱晃的余地就越小。"
          }
        ]
      },
      {
        "id": "line-5-1",
        "start_frame": 1618,
        "deadline_frame": 1762,
        "text": "如果开口留了缝，一用力，扳手会先在螺母上转过一点。",
        "knowledge_ids": [
          "detail-5"
        ]
      },
      {
        "id": "line-5-2",
        "start_frame": 1768,
        "deadline_frame": 1844,
        "text": "你会看到接触挤到两个角附近。",
        "knowledge_ids": [
          "detail-5"
        ]
      },
      {
        "id": "line-5-3",
        "start_frame": 1851,
        "deadline_frame": 1941,
        "text": "开口越松，越容易把六角的边角压伤。",
        "knowledge_ids": [
          "detail-5"
        ]
      },
      {
        "id": "line-6-1",
        "start_frame": 1956,
        "deadline_frame": 2126,
        "text": "真正拧的时候，力从手柄传到扳手头，再由两片钳口推着螺母转。",
        "knowledge_ids": [
          "detail-6"
        ],
        "subtitles": [
          {
            "offset_samples": 0,
            "text": "真正拧的时候，力从手柄传到扳手头，"
          },
          {
            "offset_samples": 149760,
            "text": "再由两片钳口推着螺母转。"
          }
        ]
      },
      {
        "id": "line-6-2",
        "start_frame": 2133,
        "deadline_frame": 2284,
        "text": "回到滚轮的窗口，它负责调好开口，手施力的位置是这根长柄。",
        "knowledge_ids": [
          "detail-6"
        ],
        "subtitles": [
          {
            "offset_samples": 0,
            "text": "回到滚轮的窗口，它负责调好开口，"
          },
          {
            "offset_samples": 139008,
            "text": "手施力的位置是这根长柄。"
          }
        ]
      },
      {
        "id": "line-6-3",
        "start_frame": 2290,
        "deadline_frame": 2453,
        "text": "换个尺寸的螺母之前，也先转一转滚轮，把开口重新调好。",
        "knowledge_ids": [
          "detail-6"
        ],
        "subtitles": [
          {
            "offset_samples": 0,
            "text": "换个尺寸的螺母之前，也先转一转滚轮，"
          },
          {
            "offset_samples": 159024,
            "text": "把开口重新调好。"
          }
        ]
      },
      {
        "id": "line-7-1",
        "start_frame": 2467,
        "deadline_frame": 2592,
        "text": "下次拿起活动扳手，可以看一眼窗口里那圈螺旋。",
        "knowledge_ids": [
          "detail-7"
        ]
      },
      {
        "id": "line-7-2",
        "start_frame": 2598,
        "deadline_frame": 2701,
        "text": "手指拨一下，转动变成钳口的直线移动。",
        "knowledge_ids": [
          "detail-7"
        ]
      },
      {
        "id": "line-7-3",
        "start_frame": 2708,
        "deadline_frame": 2794,
        "text": "套上后先贴紧两面，再扳手柄。",
        "knowledge_ids": [
          "detail-7"
        ]
      }
    ],

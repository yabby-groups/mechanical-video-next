{
  "title": "门把手回正",
  "source": "US7900978B2",
  "shots": [
    {
      "id": "hook",
      "seconds": 5.4,
      "source": [
        22,
        97
      ],
      "camera": "installed",
      "lines": [
        "按下门把手，松开，它又回到了水平。",
        "手已经松了，谁还在推它？"
      ],
      "discovery": "松手后仍有角位移"
    },
    {
      "id": "reveal",
      "seconds": 6,
      "source": [
        382,
        469
      ],
      "camera": "reveal",
      "lines": [
        "答案藏在把手根部。",
        "把盖子剖开，左侧有一根弯着排布的压簧。"
      ],
      "discovery": "回位单元在门面与把手之间"
    },
    {
      "id": "mount",
      "seconds": 6,
      "source": [
        469,
        469
      ],
      "camera": "back",
      "lines": [
        "先看门板。后面的壳体固定在门上。",
        "把手在转，壳体始终留在原处。"
      ],
      "discovery": "壳体为反力提供固定参考"
    },
    {
      "id": "explode",
      "seconds": 8,
      "source": [
        469,
        469
      ],
      "camera": "explode",
      "lines": [
        "沿轴线把零件拉开，先看清它们的位置。",
        "把手、方轴、拨片，共用这条转轴。"
      ],
      "discovery": "轴向拆解分别暴露旋转组件"
    },
    {
      "id": "square",
      "seconds": 7,
      "source": [
        469,
        469
      ],
      "camera": "square",
      "lines": [
        "把手根部有一个方孔，方轴嵌在里面。",
        "按下把手，方孔的侧面带着方轴一起转。"
      ],
      "discovery": "方孔侧面传递载荷"
    },
    {
      "id": "stack",
      "seconds": 7.2,
      "source": [
        469,
        469
      ],
      "camera": "stack",
      "lines": [
        "顺着方轴往里看，两片拨片叠在一起。",
        "它们伸出两只端座，分头托住弹簧。"
      ],
      "discovery": "两片拨片的轴向叠放与两个支承面"
    },
    {
      "id": "lost",
      "seconds": 7,
      "source": [
        475,
        529
      ],
      "camera": "axis",
      "lines": [
        "留意蓝色这片的孔。它给方轴留了转动空间。",
        "方轴压住金色那片的边，蓝色这片可以不动。"
      ],
      "discovery": "两片相同轴心而啮合时机不同"
    },
    {
      "id": "upper",
      "seconds": 6,
      "source": [
        537,
        537
      ],
      "camera": "upper",
      "lines": [
        "从上端看，蓝色拨片靠在壳体的挡块上。",
        "弹簧推它时，挡块把这股力接过去。"
      ],
      "discovery": "固定端经拨片把反力送到壳体"
    },
    {
      "id": "mid",
      "seconds": 6.2,
      "source": [
        540,
        652
      ],
      "camera": "face",
      "lines": [
        "这时再看正面。方轴带金色拨片往里压。",
        "蓝色端不动，弹簧就被两端夹短了。"
      ],
      "discovery": "在同一基准下比较两个端座位移"
    },
    {
      "id": "lower",
      "seconds": 6.4,
      "source": [
        652,
        711
      ],
      "camera": "lower",
      "lines": [
        "贴近下端。金色拨片的端座贴着弹簧。",
        "它绕方轴转过一点，两端之间的弧长就少一点。"
      ],
      "discovery": "接触点处在轴心之外"
    },
    {
      "id": "coils",
      "seconds": 7.3,
      "source": [
        630,
        630
      ],
      "camera": "coils",
      "lines": [
        "放大线圈之间的缝隙。",
        "压缩时，线圈之间靠近，整根弹簧变短。"
      ],
      "discovery": "形变集中体现在圈间距离"
    },
    {
      "id": "energy",
      "seconds": 7,
      "source": [
        684,
        684
      ],
      "camera": "energy",
      "lines": [
        "这段缩短是刚才用手压出来的。",
        "外力做的功，有一部分存进了变形的弹簧。"
      ],
      "discovery": "弹性势能与输入功"
    },
    {
      "id": "release",
      "seconds": 7.2,
      "source": [
        711,
        886
      ],
      "camera": "faceBack",
      "lines": [
        "现在松手。弹簧伸开，下端跟着往回走。",
        "它先推拨片，拨片再把方轴带回去。"
      ],
      "discovery": "原时钟完整复位，传力路径反向"
    },
    {
      "id": "torque",
      "seconds": 7.4,
      "source": [
        687,
        687
      ],
      "camera": "torque",
      "lines": [
        "推力落在轴心外边，而且沿着转动方向。",
        "这种能让轴转起来的作用，就叫力矩。"
      ],
      "discovery": "轴心与端座距离对应杠杆作用"
    },
    {
      "id": "weight",
      "seconds": 6.6,
      "source": [
        885,
        885
      ],
      "camera": "weight",
      "lines": [
        "再看外面的把手。握柄伸在轴心一侧。",
        "回到水平的途中，弹簧也把这段握柄抬起来了。"
      ],
      "discovery": "弹簧对把手重力做功"
    },
    {
      "id": "stops",
      "seconds": 7.2,
      "source": [
        651,
        651
      ],
      "camera": "stop",
      "lines": [
        "弹簧可以变形，壳体上的挡块却是固定的。",
        "这项设计用不同的挡块限制拨片的行程。"
      ],
      "discovery": "行程下限和弹簧作用不同"
    },
    {
      "id": "home",
      "seconds": 6.6,
      "source": [
        886,
        886
      ],
      "camera": "home",
      "lines": [
        "回到中位，两片拨片又靠回各自的止挡。",
        "轴回到初始角度，把手也就回到水平。"
      ],
      "discovery": "中位由止挡和轴的相对位置确定"
    },
    {
      "id": "design",
      "seconds": 7,
      "source": [
        885,
        885
      ],
      "camera": "design",
      "lines": [
        "弹簧只绕了壳体的一部分。",
        "轴右边空出来的位置，可以留给锁体的连杆。"
      ],
      "discovery": "同一实施例的非整圈布局"
    },
    {
      "id": "map",
      "seconds": 7.2,
      "source": [
        885,
        885
      ],
      "camera": "map",
      "lines": [
        "记住这条路线。下压时，方轴经拨片压缩弹簧。",
        "松手时，弹簧经拨片推回方轴和把手。"
      ],
      "discovery": "以同一剖视总结双向传递"
    },
    {
      "id": "answer",
      "seconds": 7,
      "source": [
        886,
        934
      ],
      "camera": "answer",
      "lines": [
        "外面能看到的，只是把手抬了起来。",
        "里面发生的是，刚才存下的能量又用来回正。"
      ],
      "discovery": "恢复门板外观，兑现开场问题"
    }
  ]
}
